# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env wordt nooit gecommit (staat in .gitignore).

# URL van jouw Mendix-omgeving (test/acceptatie), bv. http://localhost:8080
# of https://jouw-omgeving.mendixcloud.com
MENDIX_APP_URL=

# Testaccount waarmee de agent / de test inlogt
MENDIX_ADMIN_USER=
MENDIX_ADMIN_PASS=
